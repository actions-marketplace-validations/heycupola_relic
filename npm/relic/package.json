    "claude-code",
    "cli",
    "cursor",
    "dotenv",
    "encryption",
    "end-to-end-encryption",
    "environment-variables",
    "mcp",
    "secrets",
    "security",
    "tui"
  ],
  "license": "MIT",
  "author": "Can Vardar",
  "repository": {
    "type": "git",
    "url": "https://github.com/heycupola/relic.git"
  },
  "bin": {
    "relic": "bin/relic"
  },
  "files": [
    "bin/",
    "scripts/",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  },
  "optionalDependencies": {
    "relic-cli-darwin-arm64": "0.5.0",
    "relic-cli-darwin-x64": "0.5.0",
    "relic-cli-linux-x64": "0.5.0",
    "relic-cli-windows-x64": "0.5.0"
  },
  "engines": {
